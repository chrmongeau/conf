{{/*
   Windows carries a smaller plugin set on purpose. document-skills needs
   LibreOffice, pandoc, poppler and Node, none of which are installed on the
   Windows side, and its marketplace is only registered where it is used.
   Everything else here is identical on every machine.
*/ -}}
{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true{{ if ne .chezmoi.os "windows" }},
    "document-skills@anthropic-agent-skills": true,
    "superpowers@claude-plugins-official": true{{ end }}
  },
{{- if ne .chezmoi.os "windows" }}
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
{{- end }}
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoCompactWindow": 800000,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "skipAutoPermissionPrompt": true
}
