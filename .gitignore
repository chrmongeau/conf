# The git config fragments that hold an identity or are machine-specific. They
# belong in $HOME, never here -- this list is the backstop for the day one of
# them gets copied into the repo alongside the files that do belong.
.gitconfig.personal
.gitconfig.fao
.gitconfig.local
.gitconfig.backup-*

# ...but the templates are the whole point, so keep them.
!.gitconfig.personal.example

# Claude Code. Only the shared config in claude/ is tracked; the rest of
# ~/.claude is live state -- transcripts, credentials, plugin caches -- and
# .credentials.json in particular must never reach a public repo.
settings.local.json
.credentials.json
.claude.json
