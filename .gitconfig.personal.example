# Copy to ~/.gitconfig.personal and put your addresses in. Deliberately NOT in
# the dotfiles repo: no address is ever committed as file content.
#
# The default address and the rule that overrides it both live here, so this is
# the only file to edit when an identity changes. The work address itself has to
# sit in a second file (~/.gitconfig.fao) because git's [includeIf] can only
# name a PATH -- there is no syntax for a conditional value, and a file that
# includes itself dies with "exceeded maximum include depth".

[user]
	email = you@personal.example

# Two conditions, not one, because git treats "/" as significant in these globs
# exactly as .gitignore does:
#   **/*fao*/**  matches "fao" in a directory component  -> github.com/un-fao/x
#   **/*fao*     matches "fao" in the repo name itself   -> github.com/me/faostat
# Neither covers both on its own. Note "**fao**" matches nothing at all: "**"
# is only special as a whole path component. Both forms also match ssh remotes
# (git@github.com:un-fao/x.git), which the older **/un-fao/** pattern did not.
[includeIf "hasconfig:remote.*.url:**/*fao*/**"]
	path = ~/.gitconfig.fao
[includeIf "hasconfig:remote.*.url:**/*fao*"]
	path = ~/.gitconfig.fao
